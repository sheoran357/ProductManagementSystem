@model ProductFormViewModel
@{
    ViewData["Title"] = "Edit product";
}

<div class="panel">
    <h1>Edit product</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="error"></span>

        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Price" class="error"></span>

        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" min="0" />
        <span asp-validation-for="Stock" class="error"></span>

        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">Select a category</option>
        </select>
        <span asp-validation-for="CategoryId" class="error"></span>

        <button class="btn" type="submit">Update product</button>
        <a class="btn muted" asp-action="Index">Cancel</a>
    </form>
</div>
