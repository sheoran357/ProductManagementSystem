@model ProductViewModel
@{
    ViewData["Title"] = "Delete product";
}

<div class="panel">
    <h1>Delete product</h1>
    <p>Are you sure you want to delete this product?</p>

    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Category:</strong> @Model.CategoryName</p>
    <p><strong>Price:</strong> @Model.Price.ToString("0.00")</p>
    <p><strong>Stock:</strong> @Model.Stock</p>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button class="btn danger" type="submit">Yes, delete</button>
        <a class="btn muted" asp-action="Index">Cancel</a>
    </form>
</div>
